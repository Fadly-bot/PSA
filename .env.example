# ============================================================
# TBM Semesta Alam — Environment Variables (template)
# ============================================================
# Salin file ini menjadi `.env.local` untuk development lokal.
#
# ⚠️ JANGAN commit file `.env*` ke repository (sudah di .gitignore).
# ⚠️ JANGAN isi nilai asli di file ini — ini hanya template nama.
#    Nilai asli dimasukkan di Vercel (Project → Settings → Environment Variables).
#
# Keterangan "dibaca oleh" menunjuk ke file kode yang memakainya —
# pastikan nama variable DI SINI persis sama dengan yang dibaca kode.

# --- Database (PostgreSQL / Supabase) ---
# Dibaca oleh: src/db/index.ts (runtime Next.js) dan drizzle.config.ts (migrasi).
# Wajib ada di Vercel (Production).
# Untuk Vercel/serverless gunakan TRANSACTION POOLER Supabase (port 6543):
#   postgresql://postgres.<project-ref>:<PASSWORD_URL_ENCODED>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Aturan:
#   - Ganti <PASSWORD_URL_ENCODED> dengan password asli yang SUDAH di-URL-encode.
#   - Karakter khusus password (/ ? # % @ :) wajib di-encode: @ → %40, / → %2F, dst.
#   - JANGAN pakai tanda kutip, spasi, atau placeholder seperti [YOUR-PASSWORD].
#   - Tanpa trailing slash / spasi di awal-akhir.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tbm_semesta_alam

# --- Better Auth ---
# Dibaca oleh: src/server/auth.ts (BETTER_AUTH_URL), src/lib/auth-client.ts (NEXT_PUBLIC_BETTER_AUTH_URL).
# Di Vercel Production: https://tbmsemesta-alam.vercel.app (tanpa trailing slash).
BETTER_AUTH_SECRET=change-me-please-32-characters-minimum
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --- Situs (canonical / sitemap / robots) ---
# Dibaca oleh: src/app/layout.tsx (SITE_URL), src/app/sitemap.ts, src/app/robots.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Storage ---
# Dibaca oleh: src/server/storage.ts (server-side).
# Service role key TIDAK BOLEH dipakai di frontend.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

# --- CLI admin (opsional — hanya untuk scripts/create-admin.ts) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
