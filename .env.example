# ============================================================
# TBM Semesta Alam — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# NEVER commit .env / .env.local to Git (see .gitignore).
# ============================================================

# --- Database (Supabase PostgreSQL / any PostgreSQL) ---
# Connection string for the application database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tbm_semesta_alam

# --- Better Auth ---
# Production: a long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Public base URL of the app (NO trailing slash).
# In production this MUST be your real domain, e.g. https://tbm-semesta-alam.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Mirrored for the client-side auth library (no trailing slash).
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --- SEO / Canonical ---
# Production base URL used for canonical links, sitemap.xml, and robots.txt.
# In production this MUST be your real domain — never localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Storage (book covers) ---
# Project URL from Supabase dashboard (no trailing slash).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key (safe to expose on the client).
# NOTE: currently not referenced by application code — kept for
# documentation parity with docs/DEPLOYMENT.md.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER-SIDE ONLY, never expose to the client.
# Used by /api/books/upload to write into the `book-covers` bucket.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin Bootstrap (CLI only, scripts/create-admin.ts) ---
# Optional: set these instead of --email / --password / --name flags.
# Only used when running `npm run admin:create`. Never exposed to HTTP.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
